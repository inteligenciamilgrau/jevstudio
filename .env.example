# Copie este arquivo para `.env` e preencha a sua chave.
#
#     cp .env.example .env          (Linux/Mac)
#     copy .env.example .env        (Windows)
#
# O `.env` está no .gitignore. Só o framework lê estas variáveis — o servidor
# de jogos não tem chave nenhuma e não faz requisição para fora.

# ---------------------------------------------------------------------------
# Obrigatório
# ---------------------------------------------------------------------------

# Sua chave da TypeSafe/Jev. Pegue em https://typesafe.ai
TYPESAFE_API_KEY=cole_sua_chave_aqui


# ---------------------------------------------------------------------------
# Opcionais — só descomente se precisar
# ---------------------------------------------------------------------------

# Caminho do Python, quando ele não está no PATH. Os scripts .ps1 procuram
# sozinhos em C:\Python3*, mas se você tem várias instalações, aponte a certa.
# PYTHON=C:\Python312\python.exe

# Portas. Precisam ser diferentes: são dois processos separados.
# FRAMEWORK_PORT=8000
# GAME_PORT=8100

# Onde o framework procura o jogo quando sobe. Dá para mudar na tela depois.
# Use 127.0.0.1 e não "localhost": no Windows, localhost tenta IPv6 primeiro
# e cada requisição pode levar 2 segundos a mais.
# GAME_URL=http://127.0.0.1:8100

# Modelo e endpoint do Jev.
# JEV_MODEL=jev-latest
# JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Paciência com a API: segundos até desistir, e quantas vezes tentar de novo.
# JEV_TIMEOUT=12
# JEV_RETRIES=4
